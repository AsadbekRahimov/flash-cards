    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "vue-tsc": "^2.2.0"
  }
