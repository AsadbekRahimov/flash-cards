APP_NAME=LexiFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Used by docker-compose.prod.yml and nginx certificate paths.
APP_DOMAIN=localhost
CERTBOT_EMAIL=
APP_PORT=80
APP_PREVIOUS_KEYS=

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=redis

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_DEPRECATIONS_TRACE=false
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=lexiflow
DB_USERNAME=lexiflow
DB_PASSWORD=secret
DB_PORT_HOST=5432
DB_SSLMODE=prefer

SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_STORE=redis
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_COOKIE=lexiflow-session
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids

CACHE_STORE=redis
CACHE_PREFIX=lexiflow_cache

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_USERNAME=null
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PORT_HOST=6379
REDIS_DB=0
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_DB=1
REDIS_CACHE_LOCK_CONNECTION=locks
REDIS_QUEUE_CONNECTION=queue
REDIS_QUEUE_DB=2
REDIS_SESSION_DB=3
REDIS_LOCK_DB=4
REDIS_QUEUE=default
# Must stay above the worker's --timeout (120 in docker-compose.prod.yml): otherwise a long job is
# handed to a second worker while the first still runs it.
REDIS_QUEUE_RETRY_AFTER=180
REDIS_QUEUE_BLOCK_FOR=5
REDIS_MAX_RETRIES=3
REDIS_BACKOFF_ALGORITHM=decorrelated_jitter
REDIS_BACKOFF_BASE=100
REDIS_BACKOFF_CAP=1000
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=noeviction

MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@lexiflow.local"
MAIL_FROM_NAME="${APP_NAME}"

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_URL_SECRET=
TELEGRAM_HEADER_SECRET=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_QUEUE=high
TELEGRAM_OUTBOUND_MAX_PER_MINUTE=20
TELEGRAM_OUTBOUND_GLOBAL_PER_SECOND=25
TELEGRAM_INBOUND_MAX_PER_MINUTE=30
TELEGRAM_IP_ALLOWLIST_ENABLED=false
TELEGRAM_LOG_CHANNEL=telegram

# Content: slug of the platform default course; share of active words that need ru+uz translations to publish a course.
CONTENT_DEFAULT_COURSE_SLUG=default
CONTENT_PUBLISH_TRANSLATION_THRESHOLD=0.95

TWA_JWT_SECRET=
TWA_JWT_TTL=900
TWA_JWT_ALG=HS256
TWA_JWT_ISS=lexiflow
TWA_INIT_DATA_MAX_AGE=86400
TWA_UNAUTHORIZED_PER_MINUTE=60
# Cap on graded reviews (not words) per training session; with learning steps a 25-word lesson needs ~75.
TWA_MAX_CARDS_PER_SESSION=200
TWA_BASE_URL=

# Spaced repetition (config/learning.php, docs/06_SPACED_REPETITION.md). Values below are the defaults.
# Steps are comma-separated minutes. A card graduates to day-based SM-2 intervals after the last step.
LEARNING_ALGORITHM=sm2
LEARNING_STEPS=1,10
RELEARNING_STEPS=10
LEARNING_GRADUATING_INTERVAL_DAYS=1
LEARNING_EASY_INTERVAL_DAYS=4
# Must be >= the largest learning/relearning step so a session can finish all steps.
LEARNING_LEARN_AHEAD_MINUTES=20
LEARNING_ABANDONED_AFTER_HOURS=12
# Ceiling for any SM-2 interval, days (1..32767; the column is smallint).
LEARNING_MAX_INTERVAL_DAYS=3650
# FSRS-5 A/B (docs/06 §9): share of NEW learners bucketed into FSRS (0..100; existing learners never move),
# target retention and the 19 FSRS-5 parameters (comma-separated; leave unset for the official defaults).
FSRS_ROLLOUT_PERCENT=0
FSRS_DESIRED_RETENTION=0.9
#FSRS_WEIGHTS=
# Personal sessions expire this many hours after opening; stale group sessions are closed after the second value.
LEARNING_SESSION_TTL_HOURS=12
LEARNING_GROUP_SESSION_TTL_HOURS=24
# IELTS / SAT mock exams (Pro, docs/13 §8.4): questions per mock, whole-exam limit (seconds),
# percentile window (days) and the cache TTL (seconds) of the per-course distribution.
MOCK_EXAM_QUESTIONS=40
MOCK_EXAM_SECONDS=1200
MOCK_EXAM_PERCENTILE_DAYS=90
MOCK_EXAM_PERCENTILE_CACHE_TTL=3600

# Personal reminders (config/learning.php, docs/06 §6, docs/12 §7.5). Values below are the defaults.
# Cards due for a "N words to review" reminder; below it the streak warning or silence.
REMINDERS_DUE_THRESHOLD=1
# Floor between any two reminders (hours, >= 1); the main rule is one reminder per local day.
REMINDERS_MIN_INTERVAL_HOURS=2
# A claimed reminder older than this is dropped (minutes, >= 15).
REMINDERS_MAX_DELAY_MINUTES=120
# Learners per SELECT / next_reminder_at backfilled per run (see DEVOPS_GUIDE "Deploying 1.5b").
REMINDERS_BATCH_SIZE=200
REMINDERS_BACKFILL_LIMIT=10000
# Outgoing reminders per second (>= 1); a run spreads its jobs over at most 14 minutes. Telegram: ~30/s per bot.
REMINDERS_SEND_RATE_PER_SECOND=25

# Learner defaults for new learners (config/learners.php, docs/12 §3.1): IANA zone, HH:MM, new words/cards goal.
LEARNERS_DEFAULT_TIMEZONE=Asia/Tashkent
LEARNERS_DEFAULT_REMINDER_TIME=19:00
LEARNERS_DEFAULT_DAILY_GOAL=20
# Streak freezes a Pro learner can keep (docs/13 §7.2; +1 per local week, spent on exactly one missed day); 0 = off.
LEARNERS_STREAK_FREEZE_MAX=2

# Billing (config/billing.php, docs/12 §5). Free plan: new words per local day (Pro: unlimited).
BILLING_FREE_NEW_WORDS_PER_DAY=20
# Grace period after a paid period ends (auto-renewing providers only; manual/promo expire at once).
BILLING_GRACE_DAYS=3
# TTL (seconds) of the per-learner entitlement cache.
BILLING_CACHE_TTL=300
# Paywall: coming_soon (no payment provider yet) | purchase. Contact for learning centers that want
# to sponsor their groups; the paywall and the public site footer show it only when non-empty
# (email, @telegram_handle or https:// URL, e.g. @lexiflow_support).
BILLING_PAYWALL_MODE=coming_soon
BILLING_SUPPORT_CONTACT=
# "Request an invoice" in the /org cabinet is mailed here (empty = SITE_LEGAL_EMAIL; both empty = no button).
BILLING_INVOICE_REQUEST_EMAIL=
# Seller details printed on the invoices of learning centers (/org/<center>/invoice/<order>); empty = not printed.
SITE_LEGAL_NAME=
SITE_LEGAL_INN=
SITE_LEGAL_ADDRESS=
SITE_LEGAL_BANK=
SITE_LEGAL_BANK_ACCOUNT=
SITE_LEGAL_MFO=
SITE_LEGAL_PHONE=
SITE_LEGAL_EMAIL=
# Promo code guessing alert: log `billing.promo_rejected_burst` when one learner collects THRESHOLD
# failed redemptions within WINDOW seconds (0 disables). docs/12 §8.
BILLING_PROMO_REJECTIONS_ALERT_THRESHOLD=5
BILLING_PROMO_REJECTIONS_ALERT_WINDOW=600
# Prices in minor units (UZS: tiyin, i.e. sum x 100; XTR: whole Stars); 0 = not for sale (docs/13 §5, §12).
BILLING_PRICE_PRO_MONTH_XTR=150
BILLING_PRICE_PRO_MONTH_UZS=2900000
BILLING_PRICE_PRO_YEAR_XTR=1300
BILLING_PRICE_PRO_YEAR_UZS=24900000
BILLING_PRICE_TUTOR_MONTH_UZS=12900000
BILLING_PRICE_CENTER_S_MONTH_UZS=34900000
BILLING_PRICE_CENTER_M_MONTH_UZS=84900000
# Center year = month price x 12 x (1 - discount %), rounded to whole sums (docs/13 "Реализация 2B.9"); 0 = no discount yet.
BILLING_ORG_YEAR_DISCOUNT_PERCENT=17
# Optional explicit year prices (tiyin); when set they win over the derived one. Empty = derived.
BILLING_PRICE_TUTOR_YEAR_UZS=
BILLING_PRICE_CENTER_S_YEAR_UZS=
BILLING_PRICE_CENTER_M_YEAR_UZS=
# Pending checkout orders expire after this many minutes (Payme/Click refuse an expired order).
BILLING_ORDER_TTL_MINUTES=1440
# Discount (%) on the first month for a learner who lost a seat in a learning center (docs/13 §1.2 offers).
BILLING_POST_ORG_DISCOUNT_PCT=30
# Payment providers (docs/13 §4). An adapter is sellable only when *_ENABLED=true and the prices above are set.
BILLING_STARS_ENABLED=false
BILLING_STARS_MAX_SUBSCRIPTION_PRICE=10000
BILLING_STARS_SUBSCRIBE_WINDOW_DAYS=7
PAYME_ENABLED=false
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST_KEY=
# In APP_ENV=production the test key is refused unless this is true (leave false once testing is done).
PAYME_ALLOW_TEST_KEY=false
PAYME_CHECKOUT_URL=https://checkout.paycom.uz
# Comma-separated IPs/CIDRs of the provider's webhook callers (from its cabinet); empty = no allowlist.
PAYME_IP_ALLOWLIST=
# Days after a Payme payment during which Payme may still cancel it (refund); empty = always.
PAYME_CANCEL_AFTER_PERFORM_DAYS=
# Fiscal receipt data for Payme CheckPerformTransaction (IKPU, package code, VAT %).
PAYME_FISCAL_IKPU=
PAYME_FISCAL_PACKAGE_CODE=
PAYME_FISCAL_VAT_PERCENT=0
CLICK_ENABLED=false
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=
CLICK_CHECKOUT_URL=https://my.click.uz/services/pay
CLICK_IP_ALLOWLIST=
# An open Click Prepare older than this (ms) no longer holds an offer / keeps an expired order payable (Payme: fixed 12 h).
CLICK_TRANSACTION_TIMEOUT_MS=1800000

# Referrals (docs/13 §7.1, config/referrals.php): Pro days for both sides, the activation rule
# (N local days with >= M graded cards within W days from the link), the inviter's caps and the burst flag.
REFERRALS_REWARD_DAYS=7
REFERRALS_ACTIVATION_DAYS=3
REFERRALS_ACTIVATION_REVIEWS_PER_DAY=10
REFERRALS_ACTIVATION_WINDOW_DAYS=14
REFERRALS_MAX_REWARDS_PER_30D=10
REFERRALS_MAX_REWARDS_LIFETIME=50
REFERRALS_INVITEE_REWARDS_PER_30D=20
REFERRALS_FLAG_LINKS_PER_DAY=20
# referrals:recover re-queues only referrals activated / rewarded within this many days.
REFERRALS_RECOVER_WINDOW_DAYS=14
ACHIEVEMENTS_ENABLED=true
ORGANIZATIONS_INVITE_BURST_PER_DAY=50

# Leagues (docs/13 §7.3): weekly groups per tier, closed Monday 00:05 in LEAGUES_TIMEZONE.
LEAGUES_ENABLED=true
LEAGUES_TIMEZONE=Asia/Tashkent
LEAGUES_GROUP_CAPACITY=30
LEAGUES_PROMOTE=5
LEAGUES_DEMOTE=5
# Points per learner_daily_stats row of the week: reviews, correct answers, new words, met daily goal.
LEAGUES_POINTS_REVIEW=1
LEAGUES_POINTS_CORRECT=1
LEAGUES_POINTS_NEW_WORD=2
LEAGUES_POINTS_GOAL_MET=10
LEAGUES_STANDINGS_CACHE_SECONDS=60
LEAGUES_NOTIFY_TTL_HOURS=12

TTS_SERVICE_URL=http://tts:8000
TTS_SERVICE_TIMEOUT=8
TTS_VOICE=en-US-AriaNeural
TTS_AUDIO_VERSION=1

# Operations (config/operations.php): /health/ready thresholds and retention of the append-only tables
# (pruned daily by `model:prune`).
READINESS_HEARTBEAT_MAX_AGE=180
READINESS_QUEUE_MAX_SIZE=1000
PRODUCT_EVENTS_RETENTION_DAYS=400
NOTIFICATIONS_LOG_RETENTION_DAYS=400

# Error tracking (Sentry or self-hosted GlitchTip — just another DSN). Empty DSN = disabled.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_SEND_DEFAULT_PII=false

# spatie/laravel-backup
# Comma-separated disk names (see config/filesystems.php). Default: local.
# For offsite backups add 's3' and configure AWS_* vars below.
BACKUP_DISKS=local
# Required in production; use at least 32 random bytes (for example: openssl rand -base64 48).
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_MAIL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

UID=1000
GID=1000

VITE_APP_NAME="${APP_NAME}"
VITE_PORT_HOST=5173

# Xdebug — off|debug|develop|coverage|profile (см. https://xdebug.org/docs/all_settings#mode)
XDEBUG_MODE=off

# ngrok (для локальной разработки Telegram webhook).
# Токен: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
NGROK_WEB_PORT=4040
